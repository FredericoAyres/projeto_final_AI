# Dados: nada de data/ vai para o git, só as pastas (.gitkeep) e o README
data/**
!data/**/
!data/**/.gitkeep
!data/README.md
!data/processed/manifest.parquet

# Python / Jupyter
__pycache__/
.ipynb_checkpoints/
env/
.env

# Checkpoints de modelo
*.pt
*.pth
*.ckpt

# Logs do download
logs/

# Saídas do notebook (checkpoints e tabelas de resultado)
# Os checkpoints ficam fora do git. Dos resultados, só os CSV de resumo das versões entram;
